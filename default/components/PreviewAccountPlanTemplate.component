                async function pdfPageSizeGeneration(tempArray) {
                    //condition for calculating page size when screen shot not persent
                    if(tempItemList[0]===''){
                        //setTimeout(function(){
                            for(var i=0;i<tempArray.length;i++){
                                await new Promise((resolve, reject) => {
                                    htmlToImage.toPng(tempArray[i])
                                    .then(function (dataUrl) {
                                        var img = new Image();
                                        img.src = dataUrl;
                                        img.onload = function() {
                                            PageHeight=PageHeight+((img.naturalHeight)*25.4)/96;
                                        }
                                        if(i==tempArray.length-1){
                                            setTimeout(function(){
                                                if(PageHeight<290){
                                                    j = new jsPDF();
                                                }
                                                else{
                                                    j = new jsPDF({
                                                        format: [210, PageHeight]
                                                    });
                                                }
                                                    
                                                if(j!=undefined){
                                                    handleSave(tempArray);
                                                }
                                            }, 5000);
                                        }
                                                
                                        resolve();
                                                
                                    })
                                    .catch(error => {
                                        reject(error);
                                    });

                                })
                            }
                        //},3000)
                    }
                    //condition for calculating page size when screenShot is persent
                    else{
                        let finalHeight=0;
                        for(var i=0;i<tempArray.length;i++){
                                await new Promise((resolve, reject) => {
                                    htmlToImage.toPng(tempArray[i])
                                        .then(function (dataUrl) {
                                            var img = new Image();
                                            img.src = dataUrl;
                                            img.onload = function() {
                                                PageHeight=PageHeight+((img.naturalHeight)*25.4)/96;
                                            }
                                            resolve();
                                                
                                        })
                                        .catch(error => {
                                            reject(error);
                                        });

                                })
                                
                        }
                        setTimeout(function(){
                            finalHeight=PageHeight+imageheight;
                            if(finalHeight<290){
                                j = new jsPDF();
                            }
                            else{
                                customHeight=tempImageHeight+tempCompHeight;
                                j = new jsPDF({
                                    format: [210, finalHeight]//finalHeight
                                });
                            }
                                                        
                            if(j!=undefined){
                                handleSave(tempArray);
                            }

                        }, 8000);
                    }
                }

