                async function handleSave(tempArray) {
                    timeOutVar=((tempArray.length)*2000)+5;
                    //Insert header in PDF file
                    htmlToImage.toPng(headerArray)
                    .then(function (dataUrl) {
                        var img = new Image();
                        img.src = dataUrl;
                        j.addImage(img,'PNG',0,0,210,0,'header');
                    })
                    //code for inserting screen shot in PDF file
                    let tempList=JSON.parse(previewItem.screenShotImage);
                    if(finalScreenShotList[0]!=''){
                        await new Promise((resolve, reject) => {
                            //code for inserting screenShot into pdf
                                for(let i=0; i < finalScreenShotList.length; i++){
                                    let tempSrc='data:image/png;base64,'+finalScreenShotList[i].split('-->')[0];
                                    setTimeout(function(){
                                        var img = new Image();
                                        img.src = tempSrc;
                                        
                                        img.onload = function() {
                                            let finalImageHeight=0;
                                            if((((img.naturalWidth)*25.4)/96)>210){
                                                finalImageHeight=210;
                                            }
                                            else{
                                                finalImageHeight=(((img.naturalWidth)*25.4)/96);
                                            }
                                            j.addImage(img, 'PNG', 0, tempheight, finalImageHeight, (((img.naturalHeight)*25.4)/96), 'htmlContent'+i);
                                           tempheight=tempheight+(((img.naturalHeight)*25.4)/96);
                                        }
                                    }, 3000);
                                }
                            //Code for inserting HTML content in PDF file
                                for (let m = 0; m < tempArray.length; m++) {
                                    setTimeout(function(){
                                        htmlToImage.toPng(tempArray[m])
                                        .then(function (dataUrl) {
                                            var img = new Image();
                                            img.src = dataUrl;
                                            img.onload = function() {
                                                document.getElementById('componentsId').appendChild(img);
                                                j.addImage(img, 'PNG', 0, tempheight, 210, 0, 'htmlContent1'+m);
                                                tempheight = tempheight+(((img.naturalHeight)*25.4)/96);
                                            }
                                        }) 
                                    }, 2000); 
                                }
                            //Code for Save PDF
                            setTimeout(function(){
                                const pdfDataUri = j.output('blob');
                                var reader = new FileReader();
                                reader.readAsDataURL(pdfDataUri);
                                reader.onloadend = function () {
                                    var base64String = reader.result;
                                    var contentVersion = new sforce.SObject('ContentVersion');
                                    contentVersion.Title = contentVersionTitle;
                                    contentVersion.PathOnClient = '/' + 'test.pdf';
                                    contentVersion.FirstPublishLocationId = pqpresentData.planRecordID;
                                    var tt1 = base64String.split('base64,')[1];
                                    contentVersion.VersionData = tt1;
                                    contentVersion.Description = '{!$Label.Prolifiq_PDF}';
                                    var results = sforce.connection.create([contentVersion]);
                                    spinner.style.display = 'none';
                                    var toastMessage = document.getElementById("toast-message");
                                    toastMessage.style.background = '#2e844a';
                                    toastMessage.innerHTML = 'PDF Saved Successfully';
                                    toastMessage.className = "show";
                                    setTimeout(function(){
                                        toastMessage.className = toastMessage.className.replace("show", "");
                                    }, 3000);
                                }
                            }, timeOutVar);
                        })
                    }
                     
                    //Code for inserting HTML content in PDF file when screenshot image is not persent.
                    else{
                        for (let m = 0; m < tempArray.length; m++) {
                            await new Promise((resolve, reject) => {
                                htmlToImage.toPng(tempArray[m])
                                .then(function (dataUrl) {
                                    var img = new Image();
                                    img.src = dataUrl;
                                    img.onload = function() {
                                            if(m>0){
                                                // tempheight=tempheight+(((img.naturalHeight)*25.4)/96);
                                            }
                                            j.addImage(img, 'PNG', 0, tempheight, 210, 0, 'htmlContent'+m);
                                            //imgHeight = imgHeight+img.naturalHeight;
                                            tempheight=tempheight+(((img.naturalHeight)*25.4)/96);
                                        
                                    }
                                    //Save pdf
                                    setTimeout(function(){
                                        if (m === tempArray.length - 1) {
                                            const pdfDataUri = j.output('blob');
                                            var reader = new FileReader();
                                            reader.readAsDataURL(pdfDataUri);
                                            reader.onloadend = function () {
                                                var base64String = reader.result;
                                                var contentVersion = new sforce.SObject('ContentVersion');
                                                contentVersion.Title = contentVersionTitle;
                                                contentVersion.PathOnClient = '/' + 'test.pdf';
                                                contentVersion.FirstPublishLocationId = pqpresentData.planRecordID;
                                                var tt1 = base64String.split('base64,')[1];
                                                contentVersion.VersionData = tt1;
                                                contentVersion.Description = '{!$Label.Prolifiq_PDF}';

                                                var results = sforce.connection.create([contentVersion]);
                                                spinner.style.display = 'none';
                                                var toastMessage = document.getElementById("toast-message");
                                                toastMessage.style.background = '#2e844a';
                                                toastMessage.innerHTML = 'PDF Saved Successfully';
                                                toastMessage.className = "show";
                                                setTimeout(function(){
                                                    toastMessage.className = toastMessage.className.replace("show", "");
                                                }, 3000);
                                            }
                                        }
                                    }, 10000);

                                    resolve();
                                })
                                .catch(error => {
                                    spinner.style.display = 'none';
                                    var toastMessage = document.getElementById("toast-message");
                                    toastMessage.style.background = '#ea001e';
                                    toastMessage.innerHTML = 'Something went wrong';
                                    toastMessage.className = "show";
                                    setTimeout(function(){
                                        toastMessage.className = toastMessage.className.replace("show", "");
                                    }, 3000);
                                    reject(error); // Reject the promise if there's an error
                                });
                            });
                        }
                    }
                }
                //Function for sharing pdf on button click
                function handleShare(){
                    $Lightning.createComponent(
                        "pqcrush:PQSharePDFViaEmail",
                        {},
                        "accountPlanTemplateHeader",
                        function(component) {
                            if(component){
                            }
                        }
                    );
                }
            }
            else {
                var previewItem = JSON.parse(localStorage.getItem('previewItem'));

                var spinner = document.getElementById('spinner');
                spinner.style.display = 'block';

                // Title as Account plan Name
                document.getElementById("headerTitle").innerHTML=previewItem.planName;
                var componentList = [];
                var templateList = previewItem.componentAvailable;
                if(previewItem.headerImageURL !== '' && previewItem.headerImageURL !== undefined) {
                    let tempImg = document.getElementById('canvasImg');
                    let img = document.createElement('img');
                    img.setAttribute('src', previewItem.headerImageURL);
                    tempImg.appendChild(img);
                }
                if(previewItem.accountPlanImage !== '' && previewItem.accountPlanImage !== undefined){
                    let planImg = document.getElementById('planedImg');
                    let img = document.createElement('img');
                    img.setAttribute('src', previewItem.accountPlanImage);
                    planImg.appendChild(img);
                }
                previewItem.componentAvailable.forEach(element => {
                    if(element.isRelatedObject === true) {
                        componentList.push('pqcrush:genericDataTableComponent$' + element.componentApiName);
                    }
                    else {
                        componentList.push('pqcrush:' + element.componentApiName + '$pqcrush__Account_Plan__c');
                    }
                });
                function handleBack() {
                    localStorage.clear();
                    localStorage.setItem('previewBackItem', JSON.stringify(previewItem));
                    if(previewItem.templateRecordID !== '') {
                        var templateId = previewItem.templateRecordID;
                        window.open('/apex/pqcrush__AccountPlanTemplate?id='+ encodeURIComponent(templateId), '_self');
                    }
                    else {
                        window.open('/apex/pqcrush__AccountPlanTemplate', '_self');
                    }
                }
                $Lightning.use("pqcrush:strategyApp", function() {
                    var componentsDiv = document.getElementById('componentsId');
                    var index = 0;
                    componentList.forEach(ele => {
                        let newDiv = document.createElement("div");
                        newDiv.setAttribute('id', index.toString());
                        newDiv.setAttribute('class', 'comp');
                        componentsDiv.appendChild(newDiv);
                        $Lightning.createComponent(
                            ele.split('$')[0],
                            {recordId : previewItem.planId ,sObjectName: ele.split('$')[1]},
                            index.toString(),
                            function(component) {
                            }
                        );
                        index += 1;
                        spinner.style.display = 'none';
                    });
                });
            }
        </script>
