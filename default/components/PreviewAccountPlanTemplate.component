<apex:component controller="AccountPlanTemplateController">
    <apex:includeLightning />
    <apex:slds />
    <apex:attribute type="String" name="templateImg" description=""/>
    <apex:attribute type="String" name="planImg" description=""/>
    <apex:attribute type="String" name="title" description=""/>
    <apex:attribute type="String" name="templateComp" description=""/>
    <apex:attribute type="String" name="planRecId" description=""/>
    <apex:attribute type="String" name="templateBase" description=""/>
    <apex:attribute type="String" name="fileName" description=""/>
    <apex:attribute type="String" name="recId" description=""/>
    <apex:attribute type="string" name="isShowAttribute" description=""/>
    <apex:attribute type="string" name="recordId" description=""/>

    <style>
            .bPageBlock.apexDefaultPageBlock {
                padding: 0 !important;
                margin-bottom: 0;
                border-radius: 0;
                border: 0;
                background: #f3f3f3;
            }
            .header-container {
                display: flex;
                justify-content: space-between;
                align-items: center;
                /* height: 163px; */
                background: #fff;
                padding: 1rem;
                box-shadow: 0px 4px 4px 0px #00000033;
            }
            .imgDiv {
                width: 150px;
                height: 150px;
                overflow: hidden;
                img {
                    width: 100%;
                    height: 100%;
                    object-fit: contain;
                }
            }
            .headerTitle {
                color: #181818;
                font-size: 2rem;
                font-weight: 600;
                text-align: center;
            }
            .components{
                display: flex;
                flex-direction: column;
                gap: 1rem;
                padding: 1rem;
            }
            .comp {
                background: #fff !important;
                padding: 1rem;
                border-radius: 8px;
            }
            .back {
                width: 80px;
                height: 40px;
                position: fixed;
                left: -5px;
                bottom: 8rem;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #2D50E2;
                color: white;
                z-index: 98;
                font-size: 18px;
                transform: rotate(90deg);
                border-radius: 4px 4px 0 0;
                cursor: pointer;
            }
            .pdfHeader{
                background-color: blue;
                display: flex;
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
                display: none;
            }
            .pdfName{
                color: white;
                font-size: 20px;
                padding: 1rem;
            }
            .pdfButton{
                display: flex;
                gap: 7px;
                padding: 1rem;
            }
            .btncls{
            background: white;
            padding: 10px;
            border-radius: 2px;
            cursor: pointer;
            }
            .myicon{
            font-size: 20px;
            width: 1em !important;
            }
            #toast-message {
                    visibility: hidden;
                    min-width: 250px;
                    margin-left: -125px;
                    /* background-color: #2e844a; */
                    color: #fff;
                    text-align: center;
                    border-radius: 2px;
                    padding: 16px;
                    position: fixed;
                    z-index: 10000;
                    left: 50%;
                    font-size: 17px;
                }
                #toast-message.show {
                    visibility: visible;
                    -webkit-animation: fadein 0.5s, fadeout 0.5s 2.5s;
                    animation: fadein 0.5s, fadeout 0.5s 2.5s;
                }
                .shareButton{
                    pointer-events: none;
                    opacity: 0.4;
                }
                .slds-spinner_container{
                    position:fixed;
                }
    </style>
    <div id="toast-message"></div>
    <div id="spinner" class="slds-spinner_container" style="position:fixed">
        <div role="status" class="slds-spinner slds-spinner_medium slds-spinner_brand">
            <span class="slds-assistive-text">{!$Label.Loading}</span>
            <div class="slds-spinner__dot-a"></div>
            <div class="slds-spinner__dot-b"></div>
        </div>
    </div>

    <div id="accountPlanTemplateHeader" />
    <div class ="pdfHeader" id="pdfHeader">
            <div class="pdfName" id="pdfName">
            </div>
        <div class="pdfButton" id="pdfButton">
            <div class="saveButton btncls" id="saveButton" title="Save" onclick="generatePdf()">
                <i class="fas fa-save myicon"></i>
            </div>
            <div class="shareButton btncls" id="shareButton" title="Share" onclick="handleShare()">
                <i class="fas fa-share-alt myicon"></i>
            </div>
            <div class="cancelButton btncls" id="cancelButton" title="Cancel" onclick="handleBack()">
                <i class="far fa-times myicon"></i>
            </div>
        </div>
    </div>

