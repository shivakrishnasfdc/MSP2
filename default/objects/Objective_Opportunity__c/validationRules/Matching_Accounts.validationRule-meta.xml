<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Matching_Accounts</fullName>
    <active>false</active>
    <errorConditionFormula>Objective__r.Account_Plan__r.Account__c !=  Opportunity__r.AccountId</errorConditionFormula>
    <errorMessage>Account must match on Account Plan linked to Objective and the Opportunity</errorMessage>
</ValidationRule>
