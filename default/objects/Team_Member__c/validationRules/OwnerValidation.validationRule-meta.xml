<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>OwnerValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(!ISPICKVAL(Role__c, &apos;Edit&apos;), User__c ==  Account_Plan__r.OwnerId)</errorConditionFormula>
    <errorDisplayField>Role__c</errorDisplayField>
    <errorMessage>The owner must be an editor</errorMessage>
</ValidationRule>
